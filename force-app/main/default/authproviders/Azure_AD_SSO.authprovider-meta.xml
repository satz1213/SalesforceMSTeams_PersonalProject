<?xml version="1.0" encoding="UTF-8"?>
<!--
  "Login with Microsoft" SSO for the org, per the "Salesforce in Teams" auth plan: this lets people
  authenticate to Salesforce using their existing Microsoft/Entra session (the same one Teams
  itself uses) instead of a separate Salesforce username/password, when the OAuth authorize popup
  from the new "Salesforce in Teams" tab shows Salesforce's login screen. This does not replace
  Salesforce login for anyone who doesn't use it - it's an additional login option.

  Provider Type is OpenIdConnect (not the built-in "Microsoft" convenience type, and not the legacy
  "Microsoft Access Control Service" type) - this is the current, documented way to federate
  Salesforce login to Azure AD/Entra, giving full explicit control over the authorize/token
  endpoints for this org's specific tenant.

  fullName (Azure_AD_SSO) is deliberately fixed - Salesforce derives this Auth Provider's callback
  URL from it (https://<My Domain>/services/authcallback/Azure_AD_SSO), and that exact URL is
  already registered as the Web redirect URI on the Azure AD app registration
  ("Salesforce SSO Login", app id f947dbee-f0d7-4c2e-bc96-5d16f82c20c7) backing this provider.
  Renaming this file/fullName would break that registered redirect URI.

  consumerKey/consumerSecret are that Azure AD app registration's Application (client) ID and
  client secret - a single-tenant app registration, hence the tenant-specific (not "common")
  authorize/token URLs below, scoped to this org's own Microsoft tenant
  (80040ab0-138a-4eaa-8a1c-68e4f0465151) only.

  registrationHandler: this OpenID Connect provider type doesn't offer Salesforce's built-in
  "Existing User Linking URL" self-service linking flow (confirmed on the live Auth Provider detail
  page - only Test-Only/OAuth-Only Initialization, Callback, and Single Logout URLs are shown for
  this provider type), so AzureAdSsoRegistrationHandler.cls replaces it: it resolves a first-time
  login to one of this org's existing Users via Azure_AD_Email_Id__c instead, never auto-creating a
  new one. See that class's doc comment for details.

  userInfoUrl/idTokenIssuer: a real login attempt failed with "No_Endpoint_URL - A Userinfo
  endpoint URL is not set" - OpenIdConnect requires this even though it's absent from some field
  references. Both values below are copied verbatim from this tenant's own OIDC discovery document
  (https://login.microsoftonline.com/80040ab0-138a-4eaa-8a1c-68e4f0465151/v2.0/.well-known/openid-configuration),
  not guessed.
-->
<AuthProvider xmlns="http://soap.sforce.com/2006/04/metadata">
    <authorizeUrl>https://login.microsoftonline.com/80040ab0-138a-4eaa-8a1c-68e4f0465151/oauth2/v2.0/authorize</authorizeUrl>
    <consumerKey>f947dbee-f0d7-4c2e-bc96-5d16f82c20c7</consumerKey>
    <!-- Real secret deliberately not committed - set this to the Azure AD app registration's
         actual client secret value after deploying, via Setup > Auth. Providers > Azure_AD_SSO,
         or via a post-deploy script reading it from a secrets store. Never commit the real value. -->
    <consumerSecret>REPLACE_WITH_AZURE_AD_APP_CLIENT_SECRET</consumerSecret>
    <defaultScopes>openid profile email</defaultScopes>
    <executionUser>bhv4sathish@gmail.com</executionUser>
    <friendlyName>Login with Microsoft</friendlyName>
    <idTokenIssuer>https://login.microsoftonline.com/80040ab0-138a-4eaa-8a1c-68e4f0465151/v2.0</idTokenIssuer>
    <includeOrgIdInIdentifier>false</includeOrgIdInIdentifier>
    <isPkceEnabled>false</isPkceEnabled>
    <providerType>OpenIdConnect</providerType>
    <registrationHandler>AzureAdSsoRegistrationHandler</registrationHandler>
    <requireMfa>false</requireMfa>
    <sendAccessTokenInHeader>true</sendAccessTokenInHeader>
    <sendClientCredentialsInHeader>true</sendClientCredentialsInHeader>
    <sendSecretInApis>false</sendSecretInApis>
    <tokenUrl>https://login.microsoftonline.com/80040ab0-138a-4eaa-8a1c-68e4f0465151/oauth2/v2.0/token</tokenUrl>
    <userInfoUrl>https://graph.microsoft.com/oidc/userinfo</userInfoUrl>
</AuthProvider>
