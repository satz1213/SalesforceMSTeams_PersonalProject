<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Case Swarm Refresh</masterLabel>
    <description>Notifies Case Swarm chat UI components when a swarm is started or updated so they refresh without a full page reload.</description>
    <isExposed>true</isExposed>
    <lightningMessageFields>
        <fieldName>recordId</fieldName>
        <description>Case Id that was updated</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>action</fieldName>
        <description>swarmStarted | swarmUpdated</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>swarmType</fieldName>
        <description>Chat or Team</description>
    </lightningMessageFields>
</LightningMessageChannel>
