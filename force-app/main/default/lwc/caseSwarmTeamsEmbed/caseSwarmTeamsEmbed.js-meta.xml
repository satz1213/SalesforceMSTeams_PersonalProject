<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Case Swarm Teams Embed</masterLabel>
    <description>Embeds the case swarm Teams conversation URL in an iframe on the Case record page.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Case</object>
            </objects>
            <property
                name="height"
                type="Integer"
                default="640"
                label="Iframe height (px)"
                description="Height of the embedded Teams panel in pixels."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
