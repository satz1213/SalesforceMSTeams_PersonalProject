<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <hasActivationRequired>false</hasActivationRequired>
    <label>Salesforce In Teams</label>
    <!-- Read-only - this tab only ever links out to an existing swarm chat, never creates or edits
         one. Needed because a fresh org can default custom fields to FLS-hidden; without this the
         "Open swarm chat" button in salesforceTabRecordFull.js would just silently never show. -->
    <fieldPermissions>
        <field>Case.Swarm_Team_Url__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Swarm_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Read/write - the "Schedule Expert Call" prototype in salesforceTabRecordFull.js writes
         these via a UI API PATCH when an agent picks a suggested slot. Same FLS-defaults-hidden gap
         as the Swarm fields above; without this the Schedule button's save silently fails for a
         real per-user Teams session. -->
    <fieldPermissions>
        <field>Case.Scheduled_Expert__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Scheduled_Call_Slot__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
