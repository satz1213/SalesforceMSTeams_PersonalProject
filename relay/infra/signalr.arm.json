{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "signalRName": {
      "type": "string",
      "defaultValue": "case-swarm-signalr"
    },
    "location": {
      "type": "string",
      "defaultValue": "canadacentral"
    }
  },
  "resources": [
    {
      "type": "Microsoft.SignalRService/signalR",
      "apiVersion": "2023-02-01",
      "name": "[parameters('signalRName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Free_F1",
        "tier": "Free",
        "capacity": 1
      },
      "properties": {
        "features": [
          {
            "flag": "ServiceMode",
            "value": "Serverless"
          }
        ],
        "cors": {
          "allowedOrigins": ["*"]
        }
      }
    }
  ],
  "outputs": {
    "signalRName": {
      "type": "string",
      "value": "[parameters('signalRName')]"
    },
    "hostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.SignalRService/signalR', parameters('signalRName'))).hostName]"
    }
  }
}
