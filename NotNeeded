// Swap this import:
// import endChat from "@salesforce/apex/TeamsSwarmChatController.endChat";
import endSwarm from "@salesforce/apex/TeamsSwarmController.endSwarm";

async handleEndChat() {
    const confirmed = await LightningConfirm.open({
      label: "End Chat",
      message:
        "This permanently deletes the chat or group in Microsoft Teams for everyone in it. This cannot be undone.",
      variant: "destructive",
      theme: "warning"
    });
    if (!confirmed) {
      return;
    }

    this.isEndingChat = true;
    try {
      await endSwarm({ caseId: this.recordId });
      this.dispatchEvent(
        new ShowToastEvent({
          title: "Swarm ended",
          message: "The chat or group has been deleted in Microsoft Teams and swarm fields cleared.",
          variant: "success"
        })
      );
      this.selectedMembers = [];
      this.searchResults = [];
      this.currentMembers = [];
      this.membersLoaded = false;
      this.stopPolling();
      await refreshApex(this.wiredCaseRecord);
      await notifyRecordUpdateAvailable([{ recordId: this.recordId }]);
    } catch (error) {
      this.showError("Could not end swarm", error);
    } finally {
      this.isEndingChat = false;
    }
  }
