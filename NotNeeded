/**
 * Permanently ends a swarm by deleting the underlying Microsoft 365 object itself - not just
 * clearing the Case's reference to it (that's what resetSwarm/Clear swarm data does instead).
 * Deleting either a chat or a group already revokes every member's access in one step, so there's
 * no need to call removeChatMember/removeGroupMember per person first.
 */
public static void endSwarm(String swarmType, String chatId, String groupId) {
  if (swarmType == 'Chat') {
    deleteChat(chatId);
  } else {
    deleteGroup(groupId);
  }
}

/**
 * Deletes the M365 group backing a Team swarm - this also removes the Team itself, since a Team
 * is layered on top of its group, not a separate object. Entra soft-deletes groups for ~30 days
 * before permanent purge (a tenant admin can restore), similar in spirit to deleteChat's 7-day
 * Teams-side recovery window.
 *
 * Needs Group.ReadWrite.All (already granted for group creation - no new permission needed).
 */
public static void deleteGroup(String groupId) {
  if (String.isBlank(groupId)) {
    throw new TeamsSwarmException(
      'Cannot delete a Microsoft 365 group without a group id.'
    );
  }

  HttpRequest req = buildRequest('/v1.0/groups/' + groupId, 'DELETE');
  HttpResponse res = new Http().send(req);

  // 404 means the group is already gone - same end state, not an error.
  if (res.getStatusCode() != 204 && res.getStatusCode() != 404) {
    throw new TeamsSwarmException(
      'Failed to delete group ' +
        groupId +
        ': ' +
        res.getStatusCode() +
        ' ' +
        res.getBody()
    );
  }
}


