@AuraEnabled
public static void endSwarm(Id caseId) {
    Case matchingCase = [
        SELECT Id, Swarm_Team_Id__c, Swarm_Group_Id__c, Swarm_Status__c, Swarm_Type__c
        FROM Case
        WHERE Id = :caseId
        WITH USER_MODE
        LIMIT 1
    ];

    if (matchingCase.Swarm_Status__c != 'Active' || String.isBlank(matchingCase.Swarm_Team_Id__c)) {
        throw new AuraHandledException('This case does not have an active swarm to end.');
    }

    try {
        TeamsSwarmService.endSwarm(
            matchingCase.Swarm_Type__c,
            matchingCase.Swarm_Team_Id__c,
            matchingCase.Swarm_Group_Id__c
        );
    } catch (TeamsSwarmService.TeamsSwarmException e) {
        throw new AuraHandledException('Could not end swarm: ' + e.getMessage());
    }

    matchingCase.Swarm_Team_Id__c = null;
    matchingCase.Swarm_Group_Id__c = null;
    matchingCase.Swarm_Team_Url__c = null;
    matchingCase.Swarm_Status__c = null;
    matchingCase.Swarm_Type__c = null;

    try {
        update matchingCase;
    } catch (DmlException e) {
        throw new AuraHandledException('Swarm was deleted in Microsoft 365, but the Case could not be updated: ' + e.getMessage());
    }
}
